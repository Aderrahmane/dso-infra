[Unit]
Description=Todolist Django via Gunicorn
After=network.target

[Service]
User=root
WorkingDirectory={{ application_dir }}
ExecStart={{ venv_dir }}/bin/gunicorn --workers 2 --bind 0.0.0.0:80 todo.wsgi:application
Restart=on-failure

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ application_dir }}

[Install]
WantedBy=multi-user.target
